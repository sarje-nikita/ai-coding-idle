[Unit]
Description=DeepAgent Frontend Vite Development Server
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/ai-coding-idle/frontend
ExecStart=/usr/local/bin/npm run dev
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
